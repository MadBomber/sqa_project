# frozen_string_literal: true
# Git operations across all repos.

class Tasks
  desc "Clone all repos (safe to run on an existing workspace)"
  def clone
    @@repos.each do |repo|
      if Dir.exist?(repo)
        printf "\e[1;33m%-32s\e[0m already exists — skipping\n", repo
      else
        url = repo == "sqa-rails" ? "#{@@github}/sqa_demo-rails.git" :
              repo == "sqa-sinatra" ? "#{@@github}/sqa_demo-sinatra.git" :
              "#{@@github}/#{repo}.git"
        printf "\e[1;32m%-32s\e[0m cloning...\n", repo
        sh "git clone \"#{url}\" \"#{repo}\""
      end
    end
  end

  desc "Fetch from origin in all repos"
  def fetch
    @@repos.each do |repo|
      printf "\e[1;32m%-32s\e[0m", repo
      result = `git -C "#{repo}" fetch --quiet 2>&1`
      puts $?.success? ? "fetched" : "FAILED: #{result.strip}"
    end
  end

  desc "Pull (fast-forward only) in all repos"
  def pull
    @@repos.each do |repo|
      puts "\n\e[1;32m── #{repo}\e[0m"
      system("git -C \"#{repo}\" pull --ff-only")
    end
  end

  desc "each CMD", "Run a shell command in every repo (e.g. asgard each 'git log -1')"
  def each(cmd)
    @@repos.each do |repo|
      puts "\n\e[1;32m── #{repo}\e[0m"
      system("cd \"#{repo}\" && #{cmd}")
    end
  end

  desc "Show current branch in all repos"
  def branches
    @@repos.each do |repo|
      branch = `git -C "#{repo}" rev-parse --abbrev-ref HEAD 2>/dev/null`.strip
      status = `git -C "#{repo}" status --short 2>/dev/null`.strip
      dirty  = status.empty? ? "" : " \e[1;33m(dirty)\e[0m"
      printf "  %-32s %s%s\n", repo, branch, dirty
    end
  end
end
