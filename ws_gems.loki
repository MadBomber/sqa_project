# frozen_string_literal: true
# Gem lifecycle tasks across the workspace.

class Tasks
  @@sqa_dependents ||= %w[sqa-cli sqa-advisor].freeze

  desc "Run `bundle update` in all repos (refresh locked dependencies to newest allowed)"
  def bundle_update_all
    bundle_across_repos(@@repos, "bundle update")
  end

  desc "Run `bundle install` in all repos (install the locked dependencies)"
  def bundle_install_all
    bundle_across_repos(@@repos, "bundle install")
  end

  desc "Build gem packages in all gem repos (excludes sqa-rails)"
  def build_all
    @@gems.each do |repo|
      printf "\e[1;32m%-32s\e[0m building...\n", repo
      sh "cd \"#{repo}\" && bundle exec rake build"
    end
    puts "\nAll gems built."
  end

  desc "Install all gems locally (sqa first, then dependents)"
  def install_all
    printf "\e[1;32m%-32s\e[0m installing...\n", "sqa"
    sh "cd sqa && bundle exec rake install"

    (@@gems - ["sqa"]).each do |repo|
      printf "\e[1;32m%-32s\e[0m installing...\n", repo
      sh "cd \"#{repo}\" && bundle exec rake install"
    end
    puts "\nAll gems installed locally."
  end

  desc "Wire sqa-cli/sqa-advisor Gemfiles to use local path: ../sqa sibling (for cross-gem dev)"
  def wire_local
    @@sqa_dependents.each do |repo|
      gemfile = "#{repo}/Gemfile"
      next unless File.exist?(gemfile)
      content = File.read(gemfile)
      if content =~ /gem ["']sqa["'],\s*path:\s*["']\.\.\/sqa["']/
        printf "\e[1;33m%-32s\e[0m already wired\n", repo
      else
        updated = content.sub(/^gem ["']sqa["'].*$/, 'gem "sqa", path: "../sqa"')
        if updated == content
          printf "\e[1;31m%-32s\e[0m no `gem \"sqa\"` line found\n", repo
        else
          File.write(gemfile, updated)
          printf "\e[1;32m%-32s\e[0m wired to ../sqa\n", repo
        end
      end
    end
    puts "\nRun `asgard paths` to verify wiring, then `bundle install` in each wired repo."
  end

  desc "Restore sqa-cli/sqa-advisor Gemfiles to use the released sqa gem"
  def unwire_local
    @@sqa_dependents.each do |repo|
      gemfile = "#{repo}/Gemfile"
      next unless File.exist?(gemfile)
      content = File.read(gemfile)
      updated = content.sub(/^gem ["']sqa["'], path: ["'][^"']+["'].*$/, 'gem "sqa"')
      if updated == content
        printf "\e[1;33m%-32s\e[0m no path: override to remove\n", repo
      else
        File.write(gemfile, updated)
        printf "\e[1;32m%-32s\e[0m restored to released gem\n", repo
      end
    end
    puts "\nRun `asgard paths` to verify. Run `bundle install` in each repo afterward."
  end

  no_commands do
    # Run a bundler command in every repo. Continues past a failing repo and
    # reports a summary rather than aborting on the first error.
    def bundle_across_repos(repos, cmd)
      failed = []
      repos.each do |repo|
        printf "\e[1;32m%-32s\e[0m %s...\n", repo, cmd
        failed << repo unless system("cd \"#{repo}\" && #{cmd}")
      end

      puts ""
      if failed.empty?
        puts "\e[32mAll #{repos.size} repos: `#{cmd}` succeeded.\e[0m"
      else
        abort "\e[31m`#{cmd}` failed in: #{failed.join(', ')}\e[0m"
      end
    end
  end
end
