# frozen_string_literal: true
# SQA workspace — entry point. Run `asgard help` for available tasks.
#
# Pulls in the shared cross-project toolkit from projects/workspace/ (repo
# lists, @@core, git/quality/gems/sync/overview tasks). ws_repos is loaded
# first so @@core/@@repos are defined before the other modules reference them.
# ws_repos auto-derives everything from the filesystem: core = sqa,
# extensions = the sqa-* gems whose gemspecs depend on sqa (sqa-tai is a gem
# but not an extension — sqa depends on IT).
#
# ws_version.loki stays local: coordinated set_version/bump across ALL
# components (sqa-rails included) with CHANGELOG updates and per-repo commits —
# richer than the shared toolkit's bump_versions.

import_up "workspace/ws_repos.loki"
import_up "workspace/*.loki"
import "ws_version.loki"

class Tasks
  helper(:workspace_version) do
    file = Dir.glob("#{@@core}/lib/**/version.rb").first
    file ? File.read(file)[/VERSION\s*=\s*['"]([^'"]+)['"]/, 1] : "?.?.?" rescue "?.?.?"
  end

  header "SQA Workspace v#{workspace_version} — #{@@gems.size} gems + #{(@@repos - @@gems).size} app(s)"
  footer "Run `asgard help <task>` for usage details"

  default_task :check

  # Overrides the shared toolkit's clone: (1) sqa-rails and sqa-sinatra were
  # renamed locally but their GitHub remotes keep the old sqa_demo-* names, and
  # (2) the shared task iterates auto-detected @@repos, which only sees
  # directories that already exist — an explicit map lets clone bootstrap a
  # fresh or partial workspace.
  @@remotes ||= {
    "sqa"         => "sqa",
    "sqa-tai"     => "sqa-tai",
    "sqa-cli"     => "sqa-cli",
    "sqa-advisor" => "sqa-advisor",
    "sqa-sinatra" => "sqa_demo-sinatra",
    "sqa-rails"   => "sqa_demo-rails"
  }.freeze

  desc "Clone all repos (safe to run on an existing workspace; maps renamed GitHub remotes)"
  def clone
    @@remotes.each do |repo, remote|
      if Dir.exist?(repo)
        printf "\e[1;33m%-32s\e[0m already exists — skipping\n", repo
      else
        printf "\e[1;32m%-32s\e[0m cloning...\n", repo
        sh "git clone \"#{@@github}/#{remote}.git\" \"#{repo}\""
      end
    end
  end
end
