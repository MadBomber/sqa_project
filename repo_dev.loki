# frozen_string_literal: true
# Shared per-repo development tasks for the SQA *gem* repos
# (sqa, sqa-tai, sqa-cli, sqa-advisor, sqa-sinatra). Imported by each
# gem repo's .loki via import_up. sqa-rails is a Rails app, not a gem,
# and defines its own tasks instead of importing this file.
#
# Pulls in the shared MadBomber-level per-component tasks (DRY: one source of
# truth in madbomber/dev/, matching asgard's own golden quality.loki/
# quality_rails.loki) rather than maintaining a local copy. Each file is
# named explicitly so `import_up` keeps working no matter how deeply the
# project is nested under madbomber/ — it walks up from the component until
# it finds each one. quality_rails.loki is imported only when RAILS_ROOT is
# set. asgard runs as a separate process outside the app it's checking, so
# `defined?(Rails)` never sees the app's Rails constant — RAILS_ROOT is set
# in a Rails repo's own .envrc (`export RAILS_ROOT=$RR`, after RR is
# defined) as the signal instead.

import_up "dev/quality.loki"
import_up "dev/quality_rails.loki" if ENV["RAILS_ROOT"]
import_up "dev/gem_tasks.loki"
import_up "dev/git.loki"
